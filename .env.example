# --- Server ---
PORT=4000
TZ=Asia/Kolkata
# Comma-separated origins allowed to call the API (website, admin dashboard).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8081,http://localhost:8082

# --- MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=nineties_turf
# Auto-create/update tables from entities. Use only in development.
DB_SYNC=true

# --- Auth ---
# Two different random strings, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_another_long_random_string
# Access tokens are short-lived; the refresh token keeps the user signed in and is
# rotated on every use, so a session ends after this long without any activity.
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Refresh-token cookie (admin dashboard / browsers). Secure defaults to true when NODE_ENV=production.
# Keep strict while the dashboard and API share a site (e.g. admin.90sturf.in + api.90sturf.in);
# use none (with COOKIE_SECURE=true) only if they live on unrelated domains.
COOKIE_SECURE=false
COOKIE_SAMESITE=strict
COOKIE_DOMAIN=

# --- Seed (npm run seed) ---
SEED_ADMIN_NAME=Turf Admin
SEED_ADMIN_EMAIL=admin@90sturf.in
SEED_ADMIN_PASSWORD=choose_a_strong_password

# --- Business details printed on PDFs and emails ---
BUSINESS_NAME=90s Turf
BUSINESS_ADDRESS=Mannarpalayam Main Road, Mannarpalayam Pirivu, Salem, Tamil Nadu 636017
BUSINESS_PHONE=+91 98765 43210
BUSINESS_EMAIL=hello@90sturf.in

# --- Documents & sharing ---
# Public address of this API, used in PDF links sent to customers.
# Must be reachable from customers' phones in production (e.g. https://api.90sturf.in).
PUBLIC_BASE_URL=http://localhost:4000
# Email/WhatsApp the booking PDF on new bookings and the invoice PDF when fully paid.
AUTO_SEND_DOCUMENTS=true

# --- Email (SMTP). Leave SMTP_HOST empty in development to use a free Ethereal
# test inbox (messages are captured, not delivered; preview links are logged). ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=90s Turf <hello@90sturf.in>

# --- WhatsApp Cloud API (Meta). Leave empty to use "click to chat" links instead. ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
